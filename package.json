{
  "name": "bitcoin-basis",
  "private": true,
  "type": "module",
  "description": "Know what your Bitcoin cost. A self-hosted, end-to-end encrypted Bitcoin cost-basis app.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "engine",
    "app",
    "worker"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "mutate": "stryker run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test:coverage",
    "dev": "npm run dev -w @bitcoin-basis/app",
    "build": "npm run build -w @bitcoin-basis/app && node tools/sri.mjs",
    "hash-build": "node tools/hash-build.mjs",
    "setup": "node tools/setup.mjs",
    "preview": "npm run preview -w @bitcoin-basis/app"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.11.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
