{
  "name": "bitcoin-basis",
  "private": true,
  "type": "module",
  "description": "Know what your Bitcoin cost. A self-hosted, end-to-end encrypted Bitcoin cost-basis app.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "engine"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "fast-check": "4.10.3",
    "globals": "17.14.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
