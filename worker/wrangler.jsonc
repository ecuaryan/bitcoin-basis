{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // One Worker: static app hosting plus the /api sync endpoints. See README.md.
  "name": "bitcoin-basis",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker code runs only for the API and for /assets/* (so a missing build file is a 404, not the
    // single-page-app fallback). Everything else is a plain static asset (headers from app/public/_headers).
    "run_worker_first": ["/api/*", "/assets/*"]
  },
  // Private buckets. Rename them here if you use different bucket names.
  "r2_buckets": [
    { "binding": "DATA", "bucket_name": "bitcoin-basis-data" },
    { "binding": "BACKUP", "bucket_name": "bitcoin-basis-backup" }
  ],
  // Local-dev defaults ONLY. The deploy workflow always passes the real values on the command line
  // (--var ORIGIN:$APP_ORIGIN --var RP_ID:<hostname>) after tools/check-origin.mjs has checked them, so a
  // production deploy can never fall back to these. Account id comes from CLOUDFLARE_ACCOUNT_ID (CI variable
  // CF_ACCOUNT_ID); it is not stored here. If you rename the buckets above, rename them in tools/setup.mjs too.
  "vars": {
    "ORIGIN": "http://localhost:8787",
    "RP_ID": "localhost",
    "RP_NAME": "Bitcoin Basis",
    // Where the public BTC price comes from (fetched by the Worker, never by the browser).
    // Point it at your own mempool instance if you run one, e.g. "https://mempool.example.com".
    "MEMPOOL_URL": "https://mempool.space",
    // A second source for the live price only, asked when mempool fails twice: Coinbase's public spot price
    // (no key, nothing about you is sent). "off" uses mempool alone (then the last good price, kept 6 hours).
    "COINBASE_URL": "https://api.coinbase.com"
  },
  // Secrets (never committed): SESSION_SECRET, SETUP_CODE. Set with `wrangler secret put`.
  // Workers Rate Limiting (free), per client IP: sign-in, recovery sign-in and registration; and the
  // public price endpoints. namespace_id is any number unique within the account.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "4417", "simple": { "limit": 30, "period": 60 } },
    { "name": "PRICE_LIMITER", "namespace_id": "4418", "simple": { "limit": 120, "period": 60 } }
  ],
  // Daily copy of new objects from DATA to BACKUP.
  "triggers": { "crons": ["17 3 * * *"] },
  // No request logging or tracing: bodies and cookies never leave the Worker.
  "observability": { "enabled": false },
  "upload_source_maps": false
}
